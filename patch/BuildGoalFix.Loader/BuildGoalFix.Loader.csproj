<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CastleStory.BuildGoalFix.Loader</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GameManaged Condition="'$(GameManaged)' == ''">/games/steamapps/common/Castle Story/Castle Story_Data/Managed</GameManaged>
    <FrameworkPathOverride>$(GameManaged)</FrameworkPathOverride>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Loader.cs" />
    <Reference Include="mscorlib"><HintPath>$(GameManaged)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(GameManaged)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(GameManaged)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>lib/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil.Rocks"><HintPath>lib/Mono.Cecil.Rocks.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
